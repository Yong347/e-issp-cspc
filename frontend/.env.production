# ==============================================================================
# FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION (Vite)
# ==============================================================================

# Core Backend API Endpoints
# Left blank so the client dynamically resolves `window.location.origin` at runtime.
# This prevents hardcoded slot/hostname mismatches, handles custom domains seamlessly,
# and avoids cross-origin CORS issues when served alongside or behind the backend proxy.
VITE_API_URL=
VITE_API_BASE_URL=

# Application Header & Browser Title
VITE_APP_TITLE=e-ISSP Compliance Engine

# Institutional Identity & Portal Branding (Camarines Sur Polytechnic Colleges)
VITE_AGENCY_NAME=Camarines Sur Polytechnic Colleges
VITE_DEFAULT_AGENCY_NAME=Camarines Sur Polytechnic Colleges
VITE_AGENCY_WEBSITE=https://cspc.edu.ph

# Official Head of Agency Title (SUC / State College Standard)
VITE_AGENCY_HEAD_TITLE=College President
VITE_DEFAULT_AGENCY_HEAD_TITLE=College President

# Default Technical Implementing Unit (Pre-fills Part III.E projects)
VITE_DEFAULT_IMPLEMENTING_UNIT=Management Information Systems Office (MISO)

# Authorized Institutional Email Domain Hint
VITE_ALLOWED_DOMAINS=cspc.edu.ph